# Copy to .env at the project root, then fill in your key.

# Required: OpenRouter API key for LLM chat functionality
OPENROUTER_API_KEY=sk-or-v1-XXXXX

# Optional: Massive (Polygon.io) API key for real market data.
# Leave empty (recommended) to use the built-in market simulator - it needs no key,
# updates every 500ms, and is what the demo is tuned for. A key that is missing,
# expired, or not authorized leaves every price null and the UI shows "--".
MASSIVE_API_KEY=

# Optional: Massive polling interval in seconds. Only used when MASSIVE_API_KEY is set.
# 15 matches the free tier; lower it (2-15) on a paid plan.
MASSIVE_POLL_INTERVAL_SECONDS=15

# Optional: set to "true" for deterministic mock LLM responses (tests, no API key).
LLM_MOCK=false
